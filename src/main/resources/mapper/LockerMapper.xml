<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartlocker.dao.LockerDao">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.smartlocker.entity.Locker">
        <id column="id" property="id"/>
        <result column="locker_name" property="lockerName"/>
        <result column="location" property="location"/>
        <result column="address" property="address"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="repair_status" property="repairStatus"/>
        <result column="repair_time" property="repairTime"/>
        <result column="repair_desc" property="repairDesc"/>
        <result column="operator_id" property="operatorId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Column_List">
        id, locker_name, location, address, description, status,
        repair_status, repair_time, repair_desc, operator_id, create_time, update_time
    </sql>

    <!-- 查询所有快递柜 -->
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_locker
        ORDER BY create_time DESC
    </select>

    <!-- 多条件查询快递柜 -->
    <select id="selectByCondition" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_locker
        <where>
            <if test="lockerName != null and lockerName != ''">
                AND locker_name LIKE CONCAT('%', #{lockerName}, '%')
            </if>
            <if test="location != null and location != ''">
                AND location LIKE CONCAT('%', #{location}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
            <!-- ✅ 移除了lockerStatus和repairStatus条件（数据库中不存在这些字段） -->
        </where>
        ORDER BY create_time DESC
    </select>

    <!-- 根据ID查询快递柜 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_locker
        WHERE id = #{id}
    </select>

    <!-- 查询故障快递柜列表（待维修/维修中） -->
    <select id="selectBroken" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_locker
        WHERE repair_status IN (1, 2)
        ORDER BY repair_time DESC
    </select>

    <!-- 插入快递柜 -->
    <insert id="insert" parameterType="com.smartlocker.entity.Locker" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_locker (locker_name, location, address, description, status,
                              repair_status, repair_time, repair_desc, operator_id, create_time, update_time)
        VALUES (#{lockerName}, #{location}, #{address}, #{description}, #{status},
                COALESCE(#{repairStatus}, 0), #{repairTime}, #{repairDesc}, #{operatorId}, NOW(), NOW())
    </insert>

    <!-- 更新快递柜 -->
    <update id="update" parameterType="com.smartlocker.entity.Locker">
        UPDATE t_locker
        <set>
            <if test="lockerName != null">locker_name = #{lockerName},</if>
            <if test="location != null">location = #{location},</if>
            <if test="address != null">address = #{address},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null">status = #{status},</if>
            <if test="repairStatus != null">repair_status = #{repairStatus},</if>
            <if test="repairTime != null">repair_time = #{repairTime},</if>
            <if test="repairDesc != null">repair_desc = #{repairDesc},</if>
            <if test="operatorId != null">operator_id = #{operatorId},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <!-- 更新快递柜状态 -->
    <update id="updateStatus">
        UPDATE t_locker
        SET status = #{status}, update_time = NOW()
        WHERE id = #{id}
    </update>

    <!-- 删除快递柜 -->
    <delete id="deleteById">
        DELETE FROM t_locker WHERE id = #{id}
    </delete>

    <!-- 统计各状态的快递柜数量 -->
    <select id="countByStatus" resultType="int">
        SELECT COUNT(*) FROM t_locker
        <where>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </select>
    <!-- ✅ 移除了countByRepairStatus方法 -->

</mapper>