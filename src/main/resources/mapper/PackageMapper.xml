<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartlocker.dao.PackageDao">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.smartlocker.entity.Package">
        <id column="id" property="id"/>
        <result column="package_no" property="packageNo"/>
        <result column="sender_name" property="senderName"/>
        <result column="sender_phone" property="senderPhone"/>
        <result column="receiver_id" property="receiverId"/>
        <result column="receiver_name" property="receiverName"/>
        <result column="receiver_phone" property="receiverPhone"/>
        <result column="locker_id" property="lockerId"/>
        <result column="box_id" property="boxId"/>
        <result column="status" property="status"/>
        <result column="put_in_time" property="putInTime"/>
        <result column="take_out_time" property="takeOutTime"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 快递详细信息结果映射（多表关联查询：t_package, t_locker, t_box） -->
    <resultMap id="PackageDetailMap" type="com.smartlocker.dto.PackageDetail">
        <id column="id" property="id"/>
        <result column="package_no" property="packageNo"/>
        <result column="sender_name" property="senderName"/>
        <result column="sender_phone" property="senderPhone"/>
        <result column="receiver_id" property="receiverId"/>
        <result column="receiver_name" property="receiverName"/>
        <result column="receiver_phone" property="receiverPhone"/>
        <result column="locker_id" property="lockerId"/>
        <result column="locker_name" property="lockerName"/>
        <result column="locker_location" property="lockerLocation"/>
        <result column="box_id" property="boxId"/>
        <result column="box_number" property="boxNumber"/>
        <result column="box_size" property="boxSize"/>
        <result column="status" property="status"/>
        <result column="status_desc" property="statusDesc"/>
        <result column="put_in_time" property="putInTime"/>
        <result column="take_out_time" property="takeOutTime"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Column_List">
        id, package_no, sender_name, sender_phone, receiver_id, receiver_name, receiver_phone,
        locker_id, box_id, status, put_in_time, take_out_time, create_time, update_time
    </sql>

    <!-- 查询所有快递 -->
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_package
        ORDER BY create_time DESC
    </select>

    <!-- 根据ID查询快递 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_package
        WHERE id = #{id}
    </select>

    <!-- 根据快递单号查询快递 -->
    <select id="selectByPackageNo" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_package
        WHERE package_no = #{packageNo}
    </select>

    <!-- 根据收件人ID查询快递 -->
    <select id="selectByReceiverId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_package
        WHERE receiver_id = #{receiverId}
        ORDER BY create_time DESC
    </select>

    <!-- 插入快递 -->
    <insert id="insert" parameterType="com.smartlocker.entity.Package" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_package (
        package_no, sender_name, sender_phone, receiver_id, receiver_name, receiver_phone,
        locker_id, box_id, status, put_in_time, take_out_time, create_time, update_time
        ) VALUES (
        #{packageNo}, #{senderName}, #{senderPhone}, #{receiverId}, #{receiverName}, #{receiverPhone},
        #{lockerId}, #{boxId}, #{status}, #{putInTime}, #{takeOutTime}, NOW(), NOW()
        )
    </insert>

    <!-- 更新快递 -->
    <update id="update" parameterType="com.smartlocker.entity.Package">
        UPDATE t_package
        <set>
            <if test="packageNo != null">package_no = #{packageNo},</if>
            <if test="senderName != null">sender_name = #{senderName},</if>
            <if test="senderPhone != null">sender_phone = #{senderPhone},</if>
            <if test="receiverId != null">receiver_id = #{receiverId},</if>
            <if test="receiverName != null">receiver_name = #{receiverName},</if>
            <if test="receiverPhone != null">receiver_phone = #{receiverPhone},</if>
            <if test="lockerId != null">locker_id = #{lockerId},</if>
            <if test="boxId != null">box_id = #{boxId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="putInTime != null">put_in_time = #{putInTime},</if>
            <if test="takeOutTime != null">take_out_time = #{takeOutTime},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <!-- 删除快递 -->
    <delete id="deleteById">
        DELETE FROM t_package WHERE id = #{id}
    </delete>

    <!-- 查询快递详细信息（多表关联查询：t_package, t_locker, t_box） -->
    <select id="selectPackageDetails" resultMap="PackageDetailMap">
        SELECT
        p.id,
        p.package_no,
        p.sender_name,
        p.sender_phone,
        p.receiver_id,
        p.receiver_name,
        p.receiver_phone,
        p.locker_id,
        l.locker_name,
        l.location AS locker_location,
        p.box_id,
        b.box_number,
        b.box_size,
        p.status,
        CASE p.status
        WHEN 1 THEN '待取件'
        WHEN 2 THEN '已取件'
        WHEN 0 THEN '已取消'
        ELSE '未知'
        END AS status_desc,
        p.put_in_time,
        p.take_out_time,
        p.create_time
        FROM t_package p
        LEFT JOIN t_locker l ON p.locker_id = l.id
        LEFT JOIN t_box b ON p.box_id = b.id
        ORDER BY p.create_time DESC
    </select>

    <!-- 根据ID查询快递详细信息 -->
    <select id="selectPackageDetailById" resultMap="PackageDetailMap">
        SELECT
        p.id,
        p.package_no,
        p.sender_name,
        p.sender_phone,
        p.receiver_id,
        p.receiver_name,
        p.receiver_phone,
        p.locker_id,
        l.locker_name,
        l.location AS locker_location,
        p.box_id,
        b.box_number,
        b.box_size,
        p.status,
        CASE p.status
        WHEN 1 THEN '待取件'
        WHEN 2 THEN '已取件'
        WHEN 0 THEN '已取消'
        ELSE '未知'
        END AS status_desc,
        p.put_in_time,
        p.take_out_time,
        p.create_time
        FROM t_package p
        LEFT JOIN t_locker l ON p.locker_id = l.id
        LEFT JOIN t_box b ON p.box_id = b.id
        WHERE p.id = #{id}
    </select>

</mapper>
