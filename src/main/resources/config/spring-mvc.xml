<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd
       http://www.springframework.org/schema/context
       http://www.springframework.org/schema/context/spring-context.xsd
       http://www.springframework.org/schema/mvc
       http://www.springframework.org/schema/mvc/spring-mvc.xsd">

    <!-- IOC组件扫描：扫描Controller组件 -->
    <context:component-scan base-package="com.smartlocker.controller"/>

    <!-- 开启Spring MVC注解支持 -->
    <mvc:annotation-driven/>

    <!-- 配置文件上传解析器 -->
    <bean id="multipartResolver" class="org.springframework.web.multipart.commons.CommonsMultipartResolver">
        <!-- 设置上传文件的最大尺寸为5MB -->
        <property name="maxUploadSize" value="5242880"/>
        <!-- 设置编码格式 -->
        <property name="defaultEncoding" value="UTF-8"/>
        <!-- 设置是否延迟加载 -->
        <property name="resolveLazily" value="true"/>
    </bean>

    <!-- 配置静态资源处理 -->
    <mvc:resources mapping="/static/**" location="/static/"/>
    <mvc:resources mapping="/css/**" location="/static/css/"/>
    <mvc:resources mapping="/js/**" location="/static/js/"/>
    <mvc:resources mapping="/images/**" location="/static/images/"/>
    <mvc:resources mapping="/uploads/**" location="/static/uploads/"/>

    <!-- 登录拦截器：未登录用户访问后台页面时重定向到登录页 -->
    <mvc:interceptors>
        <mvc:interceptor>
            <mvc:mapping path="/**"/>
            <mvc:exclude-mapping path="/login"/>
            <mvc:exclude-mapping path="/"/>
            <mvc:exclude-mapping path="/static/**"/>
            <mvc:exclude-mapping path="/css/**"/>
            <mvc:exclude-mapping path="/js/**"/>
            <mvc:exclude-mapping path="/images/**"/>
            <mvc:exclude-mapping path="/uploads/**"/>
            <mvc:exclude-mapping path="/users/register"/>
            <mvc:exclude-mapping path="/assistant"/>
            <mvc:exclude-mapping path="/assistant/chat"/>
            <mvc:exclude-mapping path="/404"/>
            <mvc:exclude-mapping path="/error"/>
            <bean class="com.smartlocker.interceptor.LoginInterceptor"/>
        </mvc:interceptor>
    </mvc:interceptors>

    <!-- 配置视图解析器（JSP） -->
    <bean class="org.springframework.web.servlet.view.InternalResourceViewResolver">
        <!-- 视图文件前缀 -->
        <property name="prefix" value="/WEB-INF/views/"/>
        <!-- 视图文件后缀 -->
        <property name="suffix" value=".jsp"/>
        <!-- 设置视图内容类型 -->
        <property name="contentType" value="text/html;charset=UTF-8"/>
    </bean>

</beans>